<header>
    <div class="header-container">
        <img src="/Resurse/images/principala.jfif" alt="Poza principala" />
        <h1 id="titlu" class="meie-script-regular">Libraria <span>BookLand</span> <i
                class="fa-solid fa-book fa-bounce"></i>
        </h1>
        <div class="ip-user">
            IP: <%- locals.ip %>
        </div>
    </div>
    <nav>
        <input type="checkbox" id="ch-menu">
        <label for="ch-menu" id="hamburger"><i class="fa-solid fa-bars"></i></label>

        <ul class="meniu">
            <li>
                <a href="/index" class="text-icon"><i class="fa-solid fa-house fa-fade"></i> Acasa</a>
                <ul>
                    <li><a href="/index#welcome">Welcome</a></li>
                    <li><a href="/index#promotii">Promotii</a></li>
                    <li><a href="/index#anunturi">Anunturi</a></li>
                    <li><a href="/index#recomandari">Recomandari</a></li>

                </ul>

            </li>
            <li>
                <a href="/despre" class="text-icon"><i class="fa-solid fa-book-open fa-fade"></i> Despre</a>
                <ul>
                    <li><a href="/despre#welcome">Prezentare</a></li>
                    <li><a href="/despre#galerie-statica">Galerie</a></li>
                    <li><a href="/despre#video-cartile">Video carti</a></li>
                </ul>

            </li>

            <li>
                <a href="/produse" class="text-icon"><i class="fa-solid fa-wand-sparkles fa-fade"></i> Produse</a>
                <ul>
                    <li><a href="/produse">Toate</a></li>
                    <% if (locals.optiuniMeniu) { %>
                        <% for (let opt of locals.optiuniMeniu) { %>
                            <li><a href="/produse?tip=<%- opt %>"><%- opt.charAt(0).toUpperCase() + opt.slice(1) %></a></li>
                        <% } %>
                    <% } %>
                </ul>
            </li>
            <li><a href="/index#livrare"><i class="fa-solid fa-truck fa-fade"></i> Livrare</a></li>
            <li>
                <a href="/index#intrebari">
                    <i class="fa-solid fa-circle-question fa-fade"></i> Intrebari frecvente
                </a>
            </li>
        </ul>
    </nav>
</header>